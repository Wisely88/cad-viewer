    "deploy": "./scripts/deploy-gh-pages.sh"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  },
  "dependencies": {
    "dwgdxf": "^2.0.1"
  }
}
